// ONIME — multi-organisation / multi-boutiques (PostgreSQL)
// Montants en plus petite unité de la devise (XOF entier, centimes EUR, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EMPLOYEE
  SUPERADMIN
}

enum PaymentMethod {
  MANUAL
  FEDAPAY
  PAYDUNYA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OWNER)
  disabled     Boolean  @default(false)

  organizationId String?
  organization   Organization? @relation("OrganizationStaff", fields: [organizationId], references: [id], onDelete: Cascade)
  /** Employés : boutique d'affectation. Propriétaire : null (accès à toutes les boutiques). */
  boutiqueId     String?
  boutique       Boutique?     @relation("BoutiqueStaff", fields: [boutiqueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries      TimeEntry[]
  employeeDevices  EmployeeDevice[]
  pointageAttempts PointageAttempt[]  @relation("PointageAttemptUser")
  pointageAudits   PointageAuditLog[] @relation("PointageAuditActor")

  @@index([organizationId])
  @@index([boutiqueId])
}

/** Compte client SaaS : facturation, marque globale, plusieurs boutiques. */
model Organization {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logoUrl       String?
  logoUrlLight  String?
  logoUrlDark   String?
  brandColor  String  @default("#44D600")
  currency    String  @default("XOF")

  trialEndsAt        DateTime
  subscriptionEndsAt DateTime?
  planId             String?
  plan               Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  suspended          Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff       User[]        @relation("OrganizationStaff")
  boutiques   Boutique[]
  invitations Invitation[]
  payments    Payment[]

  @@index([createdAt])
}

/** Point de vente : stock, ventes, achats, pointage (périmètre opérationnel). */
model Boutique {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String?
  phone          String?
  address        String?

  workplaceLatitude  Float?
  workplaceLongitude Float?
  geofenceRadiusM    Int      @default(100)
  gpsMinAccuracyM    Int      @default(150)
  geofenceEnabled    Boolean  @default(true)
  workDayStartTime     String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff            User[]             @relation("BoutiqueStaff")
  invitations      Invitation[]
  products         Product[]
  suppliers        Supplier[]
  customers        Customer[]
  purchases        Purchase[]
  sales            Sale[]
  timeEntries      TimeEntry[]
  pointageAttempts PointageAttempt[]
  pointageAudits   PointageAuditLog[]

  @@unique([organizationId, slug])
  @@index([organizationId, name])
}

model Plan {
  id           String  @id @default(cuid())
  name         String
  description  String?
  priceMonthly Int
  active       Boolean @default(true)
  position     Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]
  payments      Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount         Int
  months         Int           @default(1)
  method         PaymentMethod @default(MANUAL)
  status         PaymentStatus @default(PAID)
  reference      String?
  note           String?
  externalId     String?
  periodStart    DateTime?
  periodEnd      DateTime?
  recordedBy     String?
  createdAt      DateTime      @default(now())

  @@unique([method, externalId])
  @@index([organizationId, createdAt])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boutiqueId     String?
  boutique       Boutique?    @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  token          String       @unique
  label          String?
  role           Role         @default(EMPLOYEE)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([boutiqueId])
}

model Product {
  id          String   @id @default(cuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  sku         String?
  /** Code-barres (EAN, UPC…) scannable ; peut être identique au SKU. */
  barcode     String?
  name        String
  description String?
  unitPrice   Int      @default(0)
  stockQty    Int      @default(0)
  minStock    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseLines PurchaseLine[]
  saleLines     SaleLine[]
  movements     StockMovement[]

  @@index([boutiqueId, name])
  @@index([boutiqueId, sku])
  @@index([boutiqueId, barcode])
}

model Supplier {
  id         String   @id @default(cuid())
  boutiqueId String
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  note       String?
  createdAt  DateTime @default(now())

  purchases Purchase[]

  @@index([boutiqueId, name])
}

model Customer {
  id         String   @id @default(cuid())
  boutiqueId String
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  note       String?
  createdAt  DateTime @default(now())

  sales Sale[]

  @@index([boutiqueId, name])
}

model Purchase {
  id         String         @id @default(cuid())
  boutiqueId String
  boutique   Boutique       @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference  String?
  status     PurchaseStatus @default(DRAFT)
  total      Int            @default(0)
  note       String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  lines PurchaseLine[]

  @@index([boutiqueId, createdAt])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Int

  @@index([purchaseId])
}

model Sale {
  id           String     @id @default(cuid())
  boutiqueId   String
  boutique     Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?
  reference    String?
  status       SaleStatus @default(DRAFT)
  total        Int        @default(0)
  note         String?
  confirmedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lines SaleLine[]

  @@index([boutiqueId, createdAt])
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int

  @@index([saleId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model TimeEntry {
  id         String    @id @default(cuid())
  boutiqueId String
  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInAt  DateTime
  checkOutAt DateTime?
  note       String?

  checkInLat        Float?
  checkInLng        Float?
  checkInAccuracyM  Float?
  checkInIp         String?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAccuracyM Float?
  checkOutIp        String?

  correctedAt      DateTime?
  correctionReason String?

  createdAt DateTime @default(now())

  @@index([boutiqueId, checkInAt])
  @@index([userId, checkInAt])
}

model EmployeeDevice {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKey    String
  userAgent    String?
  registeredAt DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@unique([userId, deviceKey])
  @@index([userId, revokedAt])
}

model PointageAttempt {
  id         String   @id @default(cuid())
  boutiqueId String
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("PointageAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  kind       String
  accepted   Boolean
  reason     String
  latitude   Float?
  longitude  Float?
  accuracyM  Float?
  ip         String?
  deviceKey  String?
  createdAt  DateTime @default(now())

  @@index([boutiqueId, createdAt])
  @@index([userId, createdAt])
}

model PointageAuditLog {
  id           String   @id @default(cuid())
  boutiqueId   String
  boutique     Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User     @relation("PointageAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId String?
  entryId      String?
  action       String
  reason       String?
  details      String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([boutiqueId, createdAt])
}
