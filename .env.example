# Beauty Clinic / Gestion Pro — copiez en .env (ignoré par git).

# --- Base de données (PostgreSQL, ex. Prisma Postgres db.prisma.io) ---
DATABASE_URL=
# Connexion directe pour `prisma migrate` (Prisma Postgres / pooler). Sur Vercel, si absent, le build reprend DATABASE_URL.
DIRECT_URL=

# --- Authentification ---
# Secret de signature des sessions (>= 32 caractères aléatoires : `openssl rand -base64 48`)
AUTH_SECRET=
# Optionnel Vercel : clé stable pour les Server Actions entre déploiements (`openssl rand -base64 32`)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Emails super-admin, séparés par des virgules (accès à /superadmin)
# Email(s) plateforme /superadmin (séparés par des virgules)
SUPERADMIN_EMAILS=me@beautyclinic.com

# --- Application ---
# URL publique du site (sert aux liens des QR codes), ex. https://menu.example.com
NEXT_PUBLIC_APP_URL=

# --- Stockage des images : local | uploadthing | vercel-blob | s3 ---
UPLOAD_PROVIDER=
# local : dossier des fichiers (défaut .uploads/)
UPLOAD_DIR=
# uploadthing (recommandé) - https://docs.uploadthing.com/
UPLOADTHING_TOKEN=
# vercel-blob
BLOB_READ_WRITE_TOKEN=
# s3 (compatible Cloudflare R2, AWS S3, MinIO…)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique de base du bucket (ex. https://pub-xxxx.r2.dev ou domaine CDN)
S3_PUBLIC_BASE_URL=

# --- Paiement d'abonnement (hooks futurs, non requis en V1) ---
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- Seed / outils (développement uniquement) ---
# Mot de passe du super-admin créé par `npm run db:seed` / `npm run superadmin:create`
SEED_SUPERADMIN_PASSWORD=

# Tests e2e uniquement : multiplie les seuils anti-abus (laisser vide en production)
RATE_LIMIT_MULTIPLIER=
